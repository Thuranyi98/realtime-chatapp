{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "outDir": ".test-dist",
    "noEmit": false,
    "isolatedModules": false,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "assets/**/*.ts",
    "assets/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ]
}
